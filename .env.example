# Local configuration for running CRIP on your laptop (uvicorn or docker compose).
# Copy to .env (git-ignored). NON-SECRET values only; secrets go in .secrets/<name>.
# In App Service the same names are App Settings (set by infra/appservice/main.bicep).

# Entra: scripts/setup-entra-app.sh prints both values.
CRIP_TENANT_ID=<your-entra-tenant-id>
CRIP_API_CLIENT_ID=<app-registration-client-id>
# CRIP_SPA_CLIENT_ID=            # only if the SPA uses a separate registration

# Access model (docs/access-model.md). app_identity: your `az login` reads Azure locally
# (CRIP's managed identity in Azure) and CRIP checks each user's access.
CRIP_AZURE_ACCESS_MODE=app_identity
CRIP_MANAGEMENT_GROUP_ID=
# Optional Entra group object ids (comma-separated) -> access levels; app roles work without these.
CRIP_PLATFORM_ADMIN_GROUP_IDS=
CRIP_COST_READER_GROUP_IDS=
CRIP_READER_GROUP_IDS=
# user_obo mode only: client secret read from .secrets/obo-client-secret (setup-entra-app.sh --obo --local-secret).
CRIP_OBO_CREDENTIAL_MODE=client_secret

# Azure AI Foundry
CRIP_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
CRIP_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o
# Set true to (re)create the agents at startup instead of running foundry/register_agents.py.
CRIP_REGISTER_AGENTS_ON_STARTUP=false

CRIP_LOG_LEVEL=INFO
# true = UI preview with labelled SAMPLE data and no sign-in. Keep false for real use.
CRIP_UI_DEMO_MODE=false
# Storage: SQLite at .local/crip.db unless .secrets/database-url exists (then PostgreSQL).
