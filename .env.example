# Local development configuration for the backend. Copy to .env (git-ignored).
# NON-SECRET values only. Secret values live as files in .secrets/ (see README).

CRIP_TENANT_ID=<your-entra-tenant-id>
CRIP_API_CLIENT_ID=<backend-api-app-registration-client-id>

# Locally there is no Workload Identity token, so the OBO exchange authenticates
# the backend app registration with a dev-only client secret read from
# .secrets/<CRIP_OBO_CLIENT_SECRET_NAME>. In AKS this is "federated" and no
# secret exists at all.
CRIP_OBO_CREDENTIAL_MODE=secret_file
CRIP_OBO_CLIENT_SECRET_NAME=obo-client-secret

CRIP_SECRETS_DIR=.secrets
CRIP_DB_SCHEMA=crip
CRIP_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
CRIP_LOG_LEVEL=INFO
